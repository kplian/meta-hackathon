# ==============================================================================
# META HACKATHON: ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Para entorno local: normalmente http://localhost:54321
SUPABASE_URL=http://localhost:54321
# Clave anónima pública
SUPABASE_ANON_KEY=your_supabase_anon_key
# Clave Service Role (solo para backend / n8n, nunca exponer en frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Conexión directa a base de datos (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ------------------------------------------------------------------------------
# N8N AUTOMATION ENGINE
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# URL pública para webhooks si usas ngrok/localtunnel/cloudflared (ej: https://abc-xyz.ngrok-free.app/)
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_key_min_16_chars
GENERIC_TIMEZONE=America/La_Paz

# ------------------------------------------------------------------------------
# LLM & AI PROVIDERS (Para nodos de LangChain / AI Agent en n8n)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# MESSAGING CHANNELS (Frontends: WhatsApp / Telegram)
# ------------------------------------------------------------------------------
# Telegram Bot Token (obtenido desde @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WhatsApp Cloud API (Meta for Developers)
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=your_whatsapp_verify_token_here
