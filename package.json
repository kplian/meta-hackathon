{
  "name": "meta-hackathon-ai-finance",
  "private": true,
  "version": "1.0.0",
  "description": "AI Family Budget Assistant: Supabase backend, n8n AI Agents (WhatsApp/Telegram) and Expo mobile app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:types": "node scripts/generate-database-types.mjs",
    "n8n:up": "docker compose up -d",
    "n8n:down": "docker compose down",
    "n8n:logs": "docker compose logs -f n8n",
    "n8n:export": "bash n8n/scripts/export-workflows.sh",
    "n8n:import": "bash n8n/scripts/import-workflows.sh",
    "mobile:start": "npm run start --workspace apps/mobile",
    "mobile:web": "npm run web --workspace apps/mobile",
    "mobile:android": "npm run android --workspace apps/mobile",
    "mobile:ios": "npm run ios --workspace apps/mobile",
    "mobile:typecheck": "npm run typecheck --workspace apps/mobile",
    "local:setup": "supabase start && node scripts/setup-local.mjs",
    "market:serve": "supabase functions serve asset-market --env-file .env",
    "test:market": "node --experimental-strip-types --test tests/asset-market.test.mjs tests/asset-refresh.test.mjs",
    "assets:refresh": "node scripts/refresh-asset-valuations.mjs",
    "test:pyramid": "node --experimental-strip-types --test tests/pyramid-calculations.test.mjs",
    "test:health": "node --experimental-strip-types --test tests/meal-plan.test.mjs"
  },
  "keywords": [
    "supabase",
    "n8n",
    "ai-agent",
    "whatsapp-bot",
    "telegram-bot",
    "family-budget",
    "hackathon",
    "expo",
    "react-native"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "supabase": "^2.15.8"
  }
}
