# Frontend env vars (Expo) - CLOUD ENVIRONMENT TEMPLATE
# Copy to .env.cloud (gitignored) and fill with your real credentials:
# - EXPO_PUBLIC_SUPABASE_URL: from Supabase Dashboard > Project Settings > General (Reference ID: https://<project-ref>.supabase.co)
# - EXPO_PUBLIC_SUPABASE_ANON_KEY: from Supabase Dashboard > Project Settings > API (Project API Keys > anon/public)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_CLOUD_ANON_KEY

# Optional Auth / SSO settings
EXPO_PUBLIC_SUPABASE_OIDC_PROVIDER=google
EXPO_PUBLIC_SUPABASE_SSO_DOMAIN=

# Demo account for cloud testing (create this user in Supabase Cloud Auth > Users)
EXPO_PUBLIC_DEMO_EMAIL=valentina@demo.local
EXPO_PUBLIC_DEMO_PASSWORD=change_me_demo_password

# Expo ports
PORT=8090
RCT_METRO_PORT=8090

