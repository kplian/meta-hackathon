# Copy to `.env` and fill with your local Supabase credentials.
# Find the anon key with: supabase status (API URL + anon key)
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OAuth/OIDC identity provider used by the "Continuar con ..." button.
# Must match a provider enabled in Supabase Auth (e.g. google, azure, okta, keycloak).
EXPO_PUBLIC_SUPABASE_OIDC_PROVIDER=google

# SSO domain for organization single sign-on (Supabase signInWithSSO).
# Leave empty to hide the SSO button.
EXPO_PUBLIC_SUPABASE_SSO_DOMAIN=

# Shared demo account for the "demo mode" button on the login screen.
# Create a matching user once in Supabase Studio (Authentication > Add user).
EXPO_PUBLIC_DEMO_EMAIL=valentina@demo.local
EXPO_PUBLIC_DEMO_PASSWORD=change_me_demo_password

# Port for the Expo / Metro dev server
PORT=8090
RCT_METRO_PORT=8090

