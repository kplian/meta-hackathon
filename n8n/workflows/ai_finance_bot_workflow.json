{
  "name": "AI Finance Bot - Telegram & WhatsApp",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "telegram-trigger-node",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        260,
        300
      ],
      "webhookId": "meta-hackathon-telegram-hook"
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Eres un Asistente de Finanzas Familiares inteligente y empático. Analiza los mensajes de gastos e ingresos. Cuando detectes un gasto o ingreso, ejecuta la herramienta de registro de Supabase. Cuando pidan resumen o saldo, ejecuta la herramienta de consulta de resumen. Responde siempre de forma corta, clara y con emojis amigables para chat de mensajería."
        }
      },
      "id": "ai-agent-node",
      "name": "AI Finance Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "openai-chat-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        440,
        520
      ]
    },
    {
      "parameters": {
        "name": "register_bot_transaction",
        "description": "Registra un gasto o ingreso en Supabase. Requiere: channel ('telegram' o 'whatsapp'), channel_user_id (ID de usuario), user_name (nombre), amount (número), type ('expense' o 'income'), category_name (categoría sugerida), description (detalle) y raw_message.",
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/register_bot_transaction",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_channel\": \"{{ $fromAI('channel', 'Canal: telegram o whatsapp') }}\",\n  \"p_channel_user_id\": \"{{ $fromAI('channel_user_id', 'ID del usuario en el canal') }}\",\n  \"p_user_name\": \"{{ $fromAI('user_name', 'Nombre del usuario') }}\",\n  \"p_amount\": {{ $fromAI('amount', 'Monto numérico') }},\n  \"p_type\": \"{{ $fromAI('type', 'expense o income') }}\",\n  \"p_category_name\": \"{{ $fromAI('category_name', 'Nombre de categoría') }}\",\n  \"p_description\": \"{{ $fromAI('description', 'Descripción corta') }}\",\n  \"p_raw_message\": \"{{ $fromAI('raw_message', 'Texto original del usuario') }}\"\n}"
      },
      "id": "tool-register-transaction",
      "name": "Tool: Register Transaction (Supabase)",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        640,
        520
      ]
    },
    {
      "parameters": {
        "name": "get_monthly_summary",
        "description": "Obtiene el balance, ingresos, gastos y desglose de categorías del mes actual desde Supabase. Requiere: channel ('telegram' o 'whatsapp') y channel_user_id.",
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/get_monthly_summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_channel\": \"{{ $fromAI('channel', 'Canal: telegram o whatsapp') }}\",\n  \"p_channel_user_id\": \"{{ $fromAI('channel_user_id', 'ID del usuario en el canal') }}\"\n}"
      },
      "id": "tool-monthly-summary",
      "name": "Tool: Monthly Summary (Supabase)",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        800,
        520
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-telegram-reply",
      "name": "Reply Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        860,
        300
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "AI Finance Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Finance Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Tool: Register Transaction (Supabase)": {
      "ai_tool": [
        [
          {
            "node": "AI Finance Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Tool: Monthly Summary (Supabase)": {
      "ai_tool": [
        [
          {
            "node": "AI Finance Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "AI Finance Agent": {
      "main": [
        [
          {
            "node": "Reply Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
